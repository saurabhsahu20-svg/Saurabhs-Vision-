<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Visible only to debug build, used by CI emulator to test IME overlap. -->
        <activity android:name=".KeyboardVisibilityTestActivity"
            android:exported="true"
            android:windowSoftInputMode="stateAlwaysVisible|adjustResize"/>
        <activity android:name=".ClipboardHistorySelfTestActivity"
            android:exported="true" />
        <activity android:name=".ThemeStickerSelfTestActivity"
            android:exported="true" />
        <!-- Only in debug builds, never in the release manifest. -->
        <activity-alias android:name=".KeyboardSettingsTestAlias"
            android:targetActivity=".KeyboardSettingsActivity"
            android:exported="true" />
        <!-- Test-only exported alias; production ThemeGalleryActivity remains private. -->
        <activity-alias android:name=".ThemeGalleryTestAlias"
            android:targetActivity=".ThemeGalleryActivity"
            android:exported="true" />
        <!-- Test-only alias; production StickerGalleryActivity stays private. -->
        <activity-alias android:name=".StickerGalleryTestAlias"
            android:targetActivity=".StickerGalleryActivity"
            android:exported="true" />
    </application>
</manifest>
