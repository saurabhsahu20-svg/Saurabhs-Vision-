<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Permission is requested only after an explicit microphone tap. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- Recognition is delegated to an installed Android provider. The app
         itself has no INTERNET, clipboard or storage permission. -->
    <queries>
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>
    <application
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:usesCleartextTraffic="false"
        android:icon="@drawable/s_board_logo"
        android:roundIcon="@drawable/s_board_logo"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <activity
            android:name=".SauneSplashActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".KeyboardSettingsActivity"
            android:exported="false"
            android:label="S Board Settings" />
        <activity
            android:name=".ThemeGalleryActivity"
            android:exported="false"
            android:label="S Board Themes"
            android:windowSoftInputMode="adjustResize" />
        <provider
            android:name=".StickerProvider"
            android:authorities="com.saurabhsvision.keyboard.stickers"
            android:exported="false"
            android:grantUriPermissions="true" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".VoicePermissionActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@android:style/Theme.Material.Light.Dialog.NoActionBar" />
        <service
            android:name=".VisionKeyboardService"
            android:label="@string/ime_label"
            android:permission="android.permission.BIND_INPUT_METHOD"
            android:exported="true">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>
    </application>
</manifest>
